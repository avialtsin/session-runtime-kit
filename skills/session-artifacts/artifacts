def hook_output(event, context):
    print(json.dumps({"hookSpecificOutput": {"hookEventName": event, "additionalContext": context}},
                     ensure_ascii=False))


def rel(root, board):
    try:
        return str(board.relative_to(root))
    except ValueError:
        return str(board)


def skill_brief():
    # Раздел «Коротко» из SKILL.md — агент получает его в начале каждой сессии.
    try:
        text = SKILL_MD.read_text(encoding="utf-8")
        return text.split("## Коротко", 1)[1].split("\n## ", 1)[0].strip()
    except Exception:
        return ""


def handoff_text(root, board, b):
    # После сжатия контекста — верх табло вместо одной строки: агент продолжает работу по нему, как
    # по handoff, без единого шага. Только то, что пересказ сжатия мог потерять, и коротко.
    def plain(item, width=220):
        # ссылки табло (относительно папки сессии) — путями от корня дерева: их можно сразу открыть
        item = re.sub(r"\[([^\]]*)\]\((<[^>]+>|[^)]+)\)",
                      lambda m: f"{m.group(1)} {rel(root, Path(link_target(board, m.group(2))))}"
                      if not re.match(r"^<?[a-z]+://", m.group(2)) else f"{m.group(1)} {m.group(2).strip('<>')}",
                      item)
        return cut(item.replace("**", ""), width)

    stage = b["stage"] + (f" · {b['stage_time']}" if b["stage_time"] else "")
    out = [f"Контекст сжат. Табло сессии {rel(root, board)} — твоя память об этой работе: продолжай по нему, "
           "переспрашивать пользователя не нужно. Верх табло:", ""]
    for label, val in (("Тема", b["title"]), ("Задача", b["task"]), ("Сейчас", stage), ("Дальше", b["next"]),
                       ("Зачем", b["why"])):
        if val:
            out.append(f"- {label}: {cut(val, 300)}")
    if b["links"]:
        out.append("- Смотреть: " + " · ".join(
            f"{l} {t if re.match(r'^[a-z]+://', t) else rel(root, Path(t))}" for l, t in b["links"]))
    stages = [f"{g['time']} {g['title']}" for g in b["history"][-5:] if g["title"]]
    if len(stages) > 1:
        out.append("- Этапы: " + " → ".join(stages))
    sections = b["sections"]
    for name, items in (("Решения", sections.get("Решения", [])[-6:]),
                        ("Открытые находки", [i for i in sections.get("Находки", []) if i.startswith("⚠")][-5:]),
                        ("Очередь", sections.get("Очередь", [])[-8:]),
                        ("Итог", sections.get("Итог", [])[-4:])):
        if items:
            out += ["", f"{name}:"] + [f"- {plain(i)}" for i in items]
    asks = [it for g in b["history"] for it in g["items"] if " 🗣 " in it][-5:]
    if asks:
        out += ["", "Последние просьбы пользователя (новые снизу; это начало его текста):"]
        out += [f"- {plain(it, 300)}" for it in asks]
    return "\n".join(out)


def opened_file(cmd, out, cwd):
    # Файл, который агент открыл пользователю вкладкой Orca: orca file open <путь>.
    if not re.search(r"\borca\s+file\s+open\b", cmd):
        return None
    rp = re.search(r'"relativePath":\s*"([^"]+)"', out)
    wt = re.search(r'"worktree":\s*"[^"]*::([^"]+)"', out)
    if rp and wt:
        return Path(wt.group(1)) / rp.group(1)
    m = re.search(r"\borca\s+file\s+open\s+(\"[^\"]+\"|'[^']+'|\S+)", cmd)
    if m:
        p = Path(m.group(1).strip("\"'")).expanduser()
        p = p if p.is_absolute() else Path(cwd) / p
        return p if p.is_file() else None
    return None


def tool_now(tool, inp):
    # Что агент делает этой командой — её описание (у Bash оно есть всегда), без вызова модели.
    if tool == "Bash":
        return inp.get("description") or cut(inp.get("command", "").splitlines()[0] if inp.get("command") else "", 80)
    if tool in ("Edit", "Write", "MultiEdit", "NotebookEdit"):
        target = inp.get("file_path") or inp.get("notebook_path") or ""
        return f"правит {Path(target).name}" if target else ""
    return ""


IMAGE_RE = re.compile(r"\.(?:png|jpe?g|webp|gif)$", re.IGNORECASE)


def seen_frame(root, board, f, note=None, when=None):
    # Кадр, который агент посмотрел (Read) или открыл пользователю, — в галерею вкладки, сам. Подпись — имя
    # файла и то, что агент делал перед этим (описание его последней команды). Вставки пользователя пишет
    # хук сообщения, копии из галереи не повторяются.
    if not (IMAGE_RE.search(f.name) and f.is_file()) or f.name.startswith("orca-paste-") \
            or "/.artifacts/gallery/" in str(f) or re.search(r"/claude-\d+/.+/images/", str(f)):
        return
    if note is None:
        live = get_now(root)
        note = live.get("text", "") if live.get("kind") == "tool" and time.time() - live.get("ts", 0) < 900 else ""
    add_frame(root, board, f, frame_caption(f), note=note, when=when)


def scan_seen(root, board, st, tp):
    # Запасной путь к хуку Read: кадры, которые агент посмотрел, — по транскрипту с прошлого раза (после
    # каждой команды и в конце хода). Работает и в сессиях, начатых до установки хука Read.
    if not tp or not Path(tp).is_file():
        return
    size = Path(tp).stat().st_size
    pos = (st.get("seen_pos") or {}).get(tp)
    # первый раз — хвост побольше: картинки, которые агент смотрел, лежат в транскрипте целиком, по мегабайту
    pos = max(size - (40 << 20), 0) if pos is None or pos > size else pos
    with open(tp, "rb") as fh:
        fh.seek(pos)
        data = fh.read(size - pos)
    end = data.rfind(b"\n") + 1
    note = st.get("seen_note", "")
    for line in data[:end].decode("utf-8", errors="ignore").splitlines():
        if '"tool_use"' not in line:
            continue
        try:
            r = json.loads(line)
        except Exception:
            continue
        msg = r.get("message") if r.get("type") == "assistant" and isinstance(r.get("message"), dict) else {}
        for c in msg.get("content") or []:
            if not isinstance(c, dict) or c.get("type") != "tool_use":
                continue
            inp = c.get("input") or {}
            if c.get("name") == "Bash" and inp.get("description"):
                note = inp["description"]
            elif c.get("name") == "Read" and inp.get("file_path"):
                seen_frame(root, board, Path(inp["file_path"]), note=note, when=local_hm(r.get("timestamp", "")))
    st["seen_pos"], st["seen_note"] = {tp: pos + end}, note


def opened_url(cmd):
    # Страница, которую агент открыл во вкладке браузера Orca: orca tab create --url / orca goto --url.
    if not re.search(r"\borca\s+(?:tab\s+create|goto)\b", cmd):
        return None
    m = re.search(r"--url[ =]+[\"']?(https?://[^\s\"']+)", cmd)
    return m.group(1) if m else None


def flush_log(b, st):
    # Записи, отложенные до следующей записи табло (строки о коммитах), — на табло в их время.
    for hm, icon, text in st.pop("pending_log", []):
        place(b, f"**{hm}** {icon} {text}")


def drop_slow_tool_hooks():
    # Убрать из настроек Claude медленные хуки после каждого вызова инструмента. Их хозяева ставят их
    # обратно (repowise init в новом проекте), поэтому — при каждом начале сессии. Хук repowise в начале
    # сессии и его MCP остаются. Настройки переписываются, только когда есть что убрать.
    try:
        text = CLAUDE_SETTINGS.read_text(encoding="utf-8")
        if not any(h in text for h in SLOW_TOOL_HOOKS):
            return
        s = json.loads(text)
        groups = (s.get("hooks") or {}).get("PostToolUse") or []
        kept = [g for g in ({**g, "hooks": [h for h in g.get("hooks", [])
                                            if not any(x in h.get("command", "") for x in SLOW_TOOL_HOOKS)]}
                            for g in groups) if g["hooks"]]
        if kept == groups:
            return
        s["hooks"]["PostToolUse"] = kept
        tmp = CLAUDE_SETTINGS.with_name(f".settings.{os.getpid()}.tmp")
        tmp.write_text(json.dumps(s, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
        os.replace(tmp, CLAUDE_SETTINGS)
    except Exception:
        pass  # хук не должен мешать сессии: не вышло — уберём в следующий раз


def hook(event):
    try:
        data = json.load(sys.stdin)
    except Exception:
        data = {}
    if event == "start":
        drop_slow_tool_hooks()
    root = worktree_root(data.get("cwd"))
    if event == "pre":  # фоновый хук перед командой: только «что делаю сейчас», без замка и вывода
        set_now(root, "tool", tool_now(data.get("tool_name", ""), data.get("tool_input") or {}))
        return
    with locked(root):
        hook_locked(event, data, root)


def hook_locked(event, data, root):
    st = load_state(root)
    board = current_board(root, st)
    if data.get("transcript_path"):
        st["transcript"] = data["transcript_path"]

    if event == "prompt":
        prompt = data.get("prompt") or ""
        if prompt_kind(prompt) != "human":
            return  # сообщение другой вкладки или фоновой задачи — не просьба пользователя
        if board:
            log_recaps(board, st, data.get("transcript_path"))
        record_prompt(root, board, st, data)
        st.update(last_prompt_ts=time.time(), last_prompt_len=len(prompt.strip()), turn_changed=False,
                  last_human_ts=time.time(), session_id=data.get("session_id"))
        save_state(root, st)
        set_now(root, "prompt", "ваше сообщение — в работе")
        if not board and len(prompt.strip()) >= 80:
            hook_output("UserPromptSubmit",
                        "Табло сессии не заведено — заведи его сейчас, до ответа: artifacts init \"<тема>\" "
                        "(этап «Разбор»; скилл session-artifacts). Просьбы и кадры пользователя табло "
                        "запишет само.")
        return

    if event == "start":
        if board and st.get("pending_log"):  # коммиты прошлой сессии этой вкладки
            b = parse(board)
            flush_log(b, st)
            save(board, b)
        save_state(root, st)
        brief = skill_brief()
        if board and data.get("source") == "compact":
            note = handoff_text(root, board, parse(board))
        elif board:
            b = parse(board)
            note = (f"В этой вкладке уже есть табло сессии. Табло: {rel(root, board)} — сейчас «{b['stage']}». "
                    "Продолжаешь ту работу — веди его; новая задача — artifacts init \"<тема>\".")
        else:
            note = ""
        text = "\n\n".join(x for x in (f"Табло сессии (скилл session-artifacts):\n{brief}" if brief else "",
                                       note) if x)
        if text:
            hook_output("SessionStart", text)
        return

    if event == "tool":
        tool = data.get("tool_name", "")
        inp = data.get("tool_input") or {}
        if tool in ("Edit", "Write", "MultiEdit", "NotebookEdit"):
            target = inp.get("file_path") or inp.get("notebook_path") or ""
            if not (board and Path(target).resolve() == board.resolve()):
                st["turn_changed"] = True
                save_state(root, st)
            return
        if tool == "Read" and board:
            seen_frame(root, board, Path(inp.get("file_path") or ""))
            return
        if tool != "Bash" or not board:
            return
        cmd = inp.get("command", "")
        resp = data.get("tool_response")
        out = (resp.get("stdout", "") + "\n" + resp.get("stderr", "")) if isinstance(resp, dict) else str(resp or "")
        cwd = data.get("cwd") or root
        b, changed = parse(board), False
        if re.search(r"\bgit\b[^|;&]*\bcommit\b", cmd) and "--dry-run" not in cmd:
            found = [(m.group(1), m.group(2), m.group(3).strip()) for m in
                     re.finditer(r"^\[([^\]\s]+)(?: \([^)]*\))? ([0-9a-f]{7,})\] (.+)$", out, re.MULTILINE)]
            if not found:  # git commit -q ничего не печатает — свежие коммиты во всех папках команды
                dirs = [cwd] + [os.path.expanduser(d.strip("\"'")) for d in
                                re.findall(r"(?:\bcd|\bgit\s+-C)\s+(\"[^\"]+\"|'[^']+'|[^\s;&|]+)", cmd)]
                for d in dict.fromkeys(dirs):
                    top = git(d, "rev-parse", "--show-toplevel") if os.path.isdir(d) else ""
                    last = git(d, "log", "-1", "--format=%h%x09%ct%x09%s").split("\t", 2) if top else []
                    if len(last) == 3 and time.time() - int(last[1]) < 120:
                        branch = git(d, "branch", "--show-current")
                        other = Path(top).resolve() != root.resolve()
                        found.append((f"{Path(top).name} {branch}" if other else branch, last[0], last[2]))
            # Строка о коммите — не в табло сразу, а при следующей записи: иначе дерево после коммита снова
            # грязное и git switch / rebase отказываются (TASK-1011).
            history = history_text(b) + "\n".join(x[2] for x in st.get("pending_log", []))
            for branch, sha, subject in found:
                if f"коммит {sha[:8]}" in history:
                    continue
                files = git(cwd, "show", "--name-only", "--format=", sha).splitlines()
                if files and all(f.endswith(BOARD_NAMES) or f"/{SHOTS}/" in f or "/кадры/" in f for f in files):
                    continue  # коммит одного табло
                st.setdefault("pending_log", []).append([stamp(b), "●", f"коммит {sha[:8]} {subject} ({branch})"])
                st["turn_changed"] = True
                save_state(root, st)
        if re.search(r"\bbacklog\b.*\btask\s+create\b", cmd):
            m = re.search(r"(TASK-\d+(?:\.\d+)*)", out)
            if m:
                t = re.search(r"create\s+(?:\"([^\"]+)\"|'([^']+)')", cmd)
                title = (t.group(1) or t.group(2)) if t else ""
                add(b, "Заведено за сессию", f"{m.group(1)} {title}".strip())
                log(b, "＋", f"на доску: {m.group(1)} {title}".strip())
                changed = True
        # Решения и материалы доски (скилл go-board) — в табло сами, с номером.
        # Сама команда, а не её текст в heredoc, строке в кавычках, grep или printf; номер — из её ответа.
        bare = re.sub(r"<<-?\s*['\"]?(\w+)['\"]?[^\n]*\n.*?^\1$", "", cmd, flags=re.S | re.M)
        bare = re.sub(r"'[^']*'|\"(?:[^\"\\]|\\.)*\"", "''", bare)
        run_at = r"(?:^|[;&|(]\s*|\bthen\s+)(?:\S*/)?"
        if re.search(run_at + r"(?:backlog\s+decision\s+create|go-board\s+decision)\b", bare, re.M):
            m = re.search(r"^(?:Решение|Created decision) (decision-\d+)", out, re.M)
            if m:
                t = re.search(r"(?:create|decision)\s+(?:\"([^\"]+)\"|'([^']+)')", cmd)
                title = (t.group(1) or t.group(2)) if t else ""
                add(b, "Решения", f"{m.group(1)} {title} — на доске".strip())
                log(b, "⚖", f"решение на доску: {m.group(1)} {title}".strip())
                changed = True
        if re.search(run_at + r"go-board\s+publish\b", bare, re.M):
            m = re.search(r"^(Выложено|Обновлено): (doc-\d+) «([^»]*)»", out, re.M)
            if m:
                log(b, "📄", f"материал на доску: {m.group(2)} {m.group(3)} ({m.group(1).lower()})")
                changed = True
        f = opened_file(cmd, out, cwd)
        if f and f.resolve() != board.resolve():
            target = str(f.resolve())
            b["links"] = ([[f.stem, target]] + [l for l in b["links"] if l[1] != target])[:MAX_LINKS]
            changed = True
            if IMAGE_RE.search(f.name):
                seen_frame(root, board, f)  # кадр, открытый пользователю, — и в галерею
        url = opened_url(cmd)
        if url:
            origin = re.match(r"^[a-z]+://[^/?#]+", url).group(0)
            label = re.sub(r"^https?://", "", origin)
            b["links"] = ([[label, url]] + [l for l in b["links"] if not l[1].startswith(origin)])[:MAX_LINKS]
            changed = True
        if changed:
            flush_log(b, st)
            save(board, b)
            st["turn_changed"] = True
        scan_seen(root, board, st, data.get("transcript_path"))
        save_state(root, st)
        return

    if event == "stop":
        # Конец хода ничего не требует от агента: итог хода — в строку внизу, недостающие кадры
        # пользователя — из транскрипта. Остановить ход можно только ради init, раз на сообщение.
        if data.get("stop_hook_active"):
            save_state(root, st)
            return
        set_now(root, "turn", first_sentence(data.get("last_assistant_message")))
        if board:
            recover_missing(root, board, st, data)
            scan_seen(root, board, st, data.get("transcript_path"))
        prompt_ts = st.get("last_prompt_ts", 0)
        nag = (not board and (st.get("turn_changed") or st.get("last_prompt_len", 0) >= 80)
               and st.get("init_nag_ts") != prompt_ts)
        if nag:
            st["init_nag_ts"] = prompt_ts
        st["turn_changed"] = False
        save_state(root, st)
        if nag:
            print(json.dumps({"decision": "block", "reason": "Табло сессии не заведено — заведи: artifacts "
                              "init \"<тема>\" (просьбы и кадры пользователя оно подхватит само). Одна "
                              "команда — и заканчивай ход."}, ensure_ascii=False))


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    cmd, args = argv[0], argv[1:]
    if cmd == "init":
        with locked(worktree_root()):
            cmd_init(args)
    elif cmd in ("ask", "stage", "next", "why", "link", "now", "queue", "problem", "fixed", "decision",
                 "done") and args:
        with locked(worktree_root()):
            cmd_simple(cmd, list(args))
    elif cmd == "shot":
        with locked(worktree_root()):
            cmd_shot(args)
    elif cmd == "path":
        print(require_board()[1])
    elif cmd == "gallery":
        root, board = require_board()
        refresh_gallery(root, board)
        print(gallery_dir(root, board) / "index.html")
    elif cmd == "statusline":
        cmd_statusline()
    elif cmd == "hook" and args:
        try:
            hook(args[0])
        except Exception as e:  # хук не должен ломать сессию
            print(f"artifacts hook: {e}", file=sys.stderr)
    else:
        sys.exit(__doc__.strip())


if __name__ == "__main__":
    main(sys.argv[1:])

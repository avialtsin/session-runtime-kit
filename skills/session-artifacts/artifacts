def osc_link(url, text):
    # OSC 8: кликабельный текст в терминале (Cmd+клик)
    return f"\033]8;;{url}\a{text}\033]8;;\a"


def cut(text, width):
    return text if len(text) <= width else text[: max(width - 1, 1)] + "…"


def term_width():
    cols = os.environ.get("COLUMNS", "")
    if not cols.isdigit():
        try:
            cols = subprocess.run("stty size </dev/tty", shell=True, capture_output=True, text=True,
                                  timeout=1).stdout.split()[1]
        except Exception:
            cols = "100"
    return max(int(cols) - 4, 30)


def cmd_statusline():
    try:
        data = json.load(sys.stdin)
    except Exception:
        data = {}
    ws = data.get("workspace") or {}
    root = worktree_root(ws.get("project_dir") or ws.get("current_dir") or data.get("cwd"))
    st = load_state(root)
    board = current_board(root, st)
    if not board:
        return
    b = parse(board)
    w = term_width()
    bold, dim, reset = "\033[1m", "\033[2m", "\033[0m"
    sep = f"{dim} · {reset}"

    # «Сейчас»: этап, который назвал агент, а за ним — что идёт на самом деле, без агента: команда,
    # которую он выполняет, итог хода, сводка Claude Code после простоя. Свежий этап важнее.
    stage = b["stage"] + (f" · {b['stage_time']}" if b["stage_time"] else "")
    what = b["task"] or (f"сессия {b['number']}: {b['title']}" if b["number"] else b["title"])
    live = get_now(root)
    recap = (recaps(data.get("transcript_path")) or [None])[-1]
    if recap:
        ts = datetime.fromisoformat(recap[0].replace("Z", "+00:00")).timestamp()
        if ts > live.get("ts", 0):
            live = {"kind": "recap", "text": recap[1], "ts": ts}
    if live.get("ts", 0) > st.get("stage_ts", 0) and time.time() - live.get("ts", 0) < 12 * 3600:
        kind, text = live.get("kind"), live["text"]
        if kind == "tool" and not re.search(r"[а-яё]", text, re.IGNORECASE):
            text = "работает"  # описание команды по-английски пользователю ничего не скажет
        elif kind in ("turn", "recap"):
            text = f"ждёт ответа · {text}"
        icon = {"turn": "✓", "recap": "⟳"}.get(kind, "⋯")
        what = f"{icon} {datetime.fromtimestamp(live['ts']):%H:%M} {text}"
    first = cut(stage or "—", w - 2)
    rest = w - 2 - len(first) - 3
    print(f"▶ {bold}{first}{reset}" + (f"{sep}{cut(what, rest)}" if rest > 8 and what else ""))

    links = [l for l in b["links"] if link_alive(l[1])]
    if links:
        shown, used = [], 2
        for label, target in links:
            label = cut(label, max(w - used - 3, 12))
            if shown and used + len(label) + 3 > w:
                break
            shown.append(osc_link(link_uri(target), label))
            used += len(label) + 3
        print("👁 " + sep.join(shown))

    if b["next"]:
        print(cut(f"→ Дальше: {b['next']}", w))

    parts = []
    gdir = gallery_dir(root, board)
    n = frame_count(gdir)
    if n:
        parts.append(osc_link((gdir / "index.html").as_uri(), f"🖼 Кадры {n}"))
    problems = sum(1 for it in b["sections"].get("Находки", []) if it.startswith("⚠"))
    if problems:
        parts.append(f"⚠ {problems}")
    queue = len(b["sections"].get("Очередь", []))
    if queue:
        parts.append(f"Очередь {queue}")
    if parts:
        print(sep.join(parts))



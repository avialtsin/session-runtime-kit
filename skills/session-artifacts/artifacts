def cmd_shot(args):
    root, board = require_board()
    key = "--key" in args
    args = [a for a in args if a != "--key"]
    if not args or not Path(args[0]).is_file():
        sys.exit("Нужен файл кадра: artifacts shot <кадр> \"<подпись>\" [--key]")
    caption = " ".join(args[1:]).strip() or Path(args[0]).stem
    shot = add_frame(root, board, args[0], caption, "key" if key else "work")
    if shot:
        b = parse(board)
        log(b, "★", f"{caption} — [кадр]({rel_md(board, shot)})")
        save(board, b)
    touch(root)


def frame_count(gdir):
    try:
        return len(json.loads((gdir / "index.json").read_text(encoding="utf-8")))
    except Exception:
        return 0


def link_alive(target):
    # Ссылка в строке — только живая: файл есть, стенд на этой машине отвечает. Чужие адреса не проверяем.
    if not re.match(r"^[a-z]+://", target):
        return Path(target).exists()
    m = re.match(r"^https?://([^/:?#]+)(?::(\d+))?", target)
    if not m or not (m.group(1) in ("localhost", "127.0.0.1", "0.0.0.0") or m.group(1).endswith(".localhost")):
        return True
    port = int(m.group(2) or (443 if target.startswith("https") else 80))
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=0.15):
            return True
    except OSError:
        return False


